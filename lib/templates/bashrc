# ~/.bashrc - this account's entry file. `dotfiles install` creates it only
# when missing and afterwards maintains just the two managed blocks; the rest
# is yours. Shared config lives in ~/.config/bash (tracked in dotfiles).
# >>> dotfiles env >>>
. "${XDG_CONFIG_HOME:-$HOME/.config}/bash/env.bash"
# <<< dotfiles env <<<
# [local] environment variables also needed by non-interactive shells

# >>> dotfiles >>>
case $- in *i*) ;; *) return ;; esac
. "${XDG_CONFIG_HOME:-$HOME/.config}/bash/common.bash"
# <<< dotfiles <<<
# [local] interactive settings, overrides of common
