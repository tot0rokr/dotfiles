# Black lists
# Listed even though `*` covers them, so they stay out while `*` is lifted
.vim/temp
.vim/undo
.vim/obsession
.vim/plugged
# plug.vim, which install_vim_plug_user (.bashrc.common) downloads
.vim/autoload
# nvim's data dir: temp/undo/obsession, lazy.nvim plugins, the pynvim venv
.local/share/nvim/
.git-credentials
.bash_history
.python_history
.cache/
.local/bin/
.local/opt/
.local/src/
.local/state/
# gh extensions (gh-dash binary)
.local/share/gh/
.config/btop/themes/
.tmux/plugins
.tmux/.resurrect
*.bak[.-]*
# keys, known_hosts and config are all per host
.ssh/
