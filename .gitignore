# Black lists
# Last match wins, so these stay below every white list line.
# Account-local files: entry files that `dotfiles install` or enter.sh creates,
# secrets, per-machine nvim files and coc's data dir.
/.bashrc
/.profile
.config/git/config
.config/git/credentials
.config/tmux/tmux.conf
.config/wezterm/wezterm.lua
.config/noti/webhook
.config/secrets.env
.config/nvim/lua/local.lua
.config/nvim/lua/plugins/local.lua
.config/nvim/lazy-lock.json
.config/coc/

# Runtime files, listed even though `*` covers them, so they stay out while `*`
# is lifted
# vim-plug and the vim plugins
.local/share/vim/
# nvim's data dir: lazy.nvim plugins and the pynvim venv (undo, swap and
# sessions live under .local/state/nvim/)
.local/share/nvim/
# TPM and the tmux plugins (TMUX_PLUGIN_MANAGER_PATH)
.local/share/tmux/
.git-credentials
.bash_history
.python_history
.cache/
.local/bin/
.local/opt/
.local/src/
.local/state/
# gh extensions (gh-dash binary)
.local/share/gh/
.config/btop/themes/
*.bak[.-]*
# keys, known_hosts and config are all per host
.ssh/
